{
  "name": "jinhualun-code",
  "version": "0.1.0",
  "private": true,
  "description": "Asset management sales internal tool demo built with React and webpack.",
  "scripts": {
    "start": "concurrently -k -n server,client -c green,blue \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "webpack serve --mode development --open false",
    "dev:server": "tsx watch server/index.ts",
    "build:vercel": "npm run build && node scripts/vercel-db-deploy.cjs",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "build:client": "webpack --mode production",
    "build:server": "node -e \"require('fs').rmSync('dist-server', { recursive: true, force: true })\" && tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "serve:server": "node dist-server/server/index.js",
    "test:server": "npm run build:server && node --test scripts/vercel-db-deploy.test.cjs api/vercel.entry.test.cjs dist-server/server/auth/auth.routes.test.js dist-server/server/agent/queryExecutor.test.js dist-server/server/agent/agent.routes.test.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "antd": "^6.3.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/react": "^18.2.67",
    "@types/react-dom": "^18.2.22",
    "@types/supertest": "^7.2.0",
    "concurrently": "^9.2.1",
    "css-loader": "^7.1.1",
    "html-webpack-plugin": "^5.6.0",
    "prisma": "^6.19.2",
    "style-loader": "^4.0.0",
    "supertest": "^7.2.2",
    "ts-loader": "^9.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  }
}
